{
  "name": "flowbite-react-template-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "socket": "node websocket-server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run socket\"",
    "format": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset --force",
    "db:init": "npm run prisma:migrate && npm run prisma:seed",
    "db:dev:migrate": "./scripts/dev-db.sh prisma migrate dev --skip-generate",
    "db:dev:seed": "./scripts/dev-db.sh prisma db seed",
    "db:dev:reset": "./scripts/dev-db.sh prisma migrate reset --force",
    "db:dev:init": "npm run db:dev:migrate && npm run db:dev:seed && prisma generate",
    "seed-permissions": "ts-node --transpile-only prisma/seedPermissions.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.0",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.2",
    "flowbite-react": "^0.10.2",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "next": "^15.1.5",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.8.1",
    "react-toastify": "^11.0.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^6.18.0",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
